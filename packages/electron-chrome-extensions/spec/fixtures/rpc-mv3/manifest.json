{
  "name": "chrome-rpc-mv3",
  "version": "1.0",
  "manifest_version": 3,
  "action": {
    "default_title": "RPC"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-script.js"],
      "run_at": "document_end"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["main-world.js"],
      "run_at": "document_end",
      "world": "MAIN"
    }
  ],
  "permissions": ["alarms", "idle", "offscreen", "scripting", "tabs"],
  "host_permissions": ["<all_urls>"]
}
