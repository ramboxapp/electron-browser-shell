{
  "name": "chrome-rpc-mv3",
  "version": "1.0",
  "manifest_version": 3,
  "action": {
    "default_title": "RPC"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content-script.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "main-world.js"
      ],
      "run_at": "document_end",
      "world": "MAIN"
    },
    {
      "matches": [
        "http://*/*"
      ],
      "js": [
        "http-matches-content-script.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "http://*/*"
      ],
      "js": [
        "main-world-second.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "main-world-third.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://only-this-host-never-matches.invalid/*",
        "http://*/*"
      ],
      "js": [
        "main-world-second-pattern.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "permissions": [
    "alarms",
    "privacy",
    "idle",
    "nativeMessaging",
    "offscreen",
    "scripting",
    "storage",
    "tabs",
    "webRequest",
    "webNavigation",
    "identity",
    "management",
    "gcm",
    "proxy",
    "sidePanel"
  ],
  "optional_permissions": [
    "clipboardRead",
    "clipboardWrite"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "commands": {
    "autofill_login": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "Autofill the login"
    },
    "lock_vault": {
      "suggested_key": {
        "default": "Ctrl+Shift+K"
      },
      "description": "Lock the vault"
    },
    "no_shortcut": {
      "description": "A command with no suggested key"
    },
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y"
      }
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "page-script.js",
        "worker-script.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "default_locale": "en"
}
